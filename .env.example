DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/hackradar
DATABASE_SSL=false
DB_POOL_SIZE=5

GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_SECRET=
# Optional override if the app's public callback URL differs from its request origin.
# GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

WAKATIME_CLIENT_ID=
WAKATIME_CLIENT_SECRET=
# WAKATIME_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/wakatime/callback

# Leave enabled for the local demo UI; disable for a real event.
ENABLE_DEMO_MODE=true
APP_BASE_URL=http://localhost:3000

# Only needed by scripts/migrate-supabase-data.cjs for one-time legacy import.
# Never set these on the running app or Render service.
# SUPABASE_SOURCE_DATABASE_URL=
# SUPABASE_SOURCE_STORAGE_URL=
# SUPABASE_SOURCE_SERVICE_ROLE_KEY=
